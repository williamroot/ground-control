# ─────────────────────────────────────────────────────────────────────
#  Kernel/Config.pm  —  rendered by entrypoint.sh from environment vars.
#  Placeholders __NAME__ are substituted at container start.
#  Structure mirrors Znuny 7.2's Kernel/Config.pm.dist (must inherit
#  from Kernel::Config::Defaults or the ObjectManager breaks).
# ─────────────────────────────────────────────────────────────────────
package Kernel::Config;

use strict;
use warnings;
use utf8;

sub Load {
    my $Self = shift;

    # ── Database (PostgreSQL) ────────────────────────────────────────
    $Self->{DatabaseHost} = '__DB_HOST__';
    $Self->{Database}     = '__DB_NAME__';
    $Self->{DatabaseUser} = '__DB_USER__';
    $Self->{DatabasePw}   = '__DB_PASS__';
    $Self->{DatabaseDSN}  =
        "DBI:Pg:dbname=$Self->{Database};host=$Self->{DatabaseHost};port=__DB_PORT__";

    # ── fs root ──────────────────────────────────────────────────────
    $Self->{Home} = '/opt/otrs';

    # ── Identity ─────────────────────────────────────────────────────
    $Self->{SystemID}        = __SYSTEM_ID__;
    $Self->{FQDN}            = '__FQDN__';
    $Self->{HttpType}        = 'https';
    # Matches the ScriptAlias in Znuny 7.2's shipped Apache include
    # (scripts/apache2-httpd.include.conf → "/znuny/").
    $Self->{ScriptAlias}     = 'znuny/';
    $Self->{AdminEmail}      = 'admin@__FQDN__';
    $Self->{Organization}    = 'Gerti Service Desk';
    $Self->{DefaultLanguage} = 'pt_BR';
    $Self->{SecureMode}      = 1;

    # ── Saída de e-mail (T-R9.1, R9 do vídeo) ────────────────────────
    #   O padrão do Znuny é entregar por `sendmail`, e **esse programa não
    #   existe na imagem** (verificado dentro do container). Consequência: o
    #   Znuny não enviava e-mail NENHUM — nem resposta a chamado, nem
    #   notificação. Nada do R9 era demonstrável, e o cliente nunca recebia
    #   resposta. Aqui o transporte passa a ser SMTP, apontado por env.
    #
    #   `SMTP` (sem TLS) é o default porque o alvo padrão é o Mailpit interno
    #   do staging, que não faz TLS. Em produção vira `SMTPTLS` ou `SMTPS`
    #   mudando `ZNUNY_SMTP_MODULE` — nenhuma outra linha muda.
    $Self->{SendmailModule}       = 'Kernel::System::Email::__SMTP_MODULE__';
    $Self->{'SendmailModule::Host'} = '__SMTP_HOST__';
    $Self->{'SendmailModule::Port'} = __SMTP_PORT__;
    $Self->{'SendmailModule::AuthUser'}     = '__SMTP_USER__';
    $Self->{'SendmailModule::AuthPassword'} = '__SMTP_PASSWORD__';
    #   Remetente de último recurso. O remetente REAL de um chamado sai do
    #   endereço de sistema da fila (é a invariante "entrou pelo suporte, sai
    #   pelo suporte" do 06:38, e é nativa do Znuny) — isto aqui só cobre
    #   notificação sem fila associada.
    $Self->{NotificationSenderEmail} = '__SMTP_FROM__';
    $Self->{NotificationSenderName}  = 'Gerti Service Desk';

    # ── Dev-friendly checks ──────────────────────────────────────────
    $Self->{CheckMXRecord}       = 0;
    $Self->{CheckEmailAddresses} = 1;

    # ── Cache → Redis ────────────────────────────────────────────────
    $Self->{'Cache::Module'} = 'Kernel::System::Cache::Redis';
    $Self->{'Cache::Redis'}  = {
        Server                => '__REDIS_HOST__:__REDIS_PORT__',
        DatabaseNumber        => __REDIS_DB__,
        RedisConnectorOptions => {},
    };
    $Self->{'Cache::InBackend'} = 1;
    $Self->{'Cache::InMemory'}  = 0;

    # ── OpenSearch / Elasticsearch ───────────────────────────────────
    #   Znuny 7.2 CORE has no ES support (separate add-on package).
    #   Endpoint the integration would use once the add-on is present:
    $Self->{'GertiOpenSearchEndpoint'} =
        'http://__OS_HOST__:__OS_PORT__';

    # ── GertiAdmin webservice shared AccessToken (#1G-a, ADR D19) ────
    #   Lido pelas operações GI custom CustomerCompanyAdd/CustomerUserAdd/
    #   SetPassword (Custom/Kernel/GenericInterface/Operation/...). DEVE
    #   bater com o token que o sidecar envia (ZNUNY_WS_TOKEN). Vazio →
    #   fail-closed (toda chamada GertiAdmin é rejeitada com AuthFail).
    $Self->{'GertiAdmin::AccessToken'} = '__GERTI_ADMIN_WS_TOKEN__';

    # ── GertiAgent webservice AccessToken (#1J) ─────────────────────
    #   Token SEPARADO, mais poderoso, lido pelas 3 ops de agente
    #   (TimeAccountingAdd/AgentTicketSearch/AgentTicketGet — root UserID=>1,
    #   cross-tenant, artigos internos). DEVE bater com ZNUNY_AGENT_WS_TOKEN
    #   que o sidecar envia. Vazio → fail-closed (AuthFail).
    $Self->{'GertiAgent::AccessToken'} = '__GERTI_AGENT_WS_TOKEN__';

    # ── Motor de automação (#1Q) — Event module GertiAutomation ─────
    #   Segredo HMAC-SHA256 compartilhado com o sidecar: o Event module
    #   GertiAutomation.pm assina o corpo do webhook com ele; o sidecar
    #   verifica (ZnunyInstance.webhook_signing_secret_ref). DEVE bater
    #   com GERTI_WEBHOOK_SIGNING_SECRET. Vazio → o módulo não posta
    #   (fail-closed: sem segredo, sem evento; nunca posta sem assinar).
    $Self->{'GertiAutomation::WebhookSecret'} = '__GERTI_WEBHOOK_SIGNING_SECRET__';
    #   Endpoint do sidecar p/ os eventos de ticket (rede interna do compose).
    $Self->{'GertiAutomation::SidecarUrl'}
        = '__GERTI_AUTOMATION_SIDECAR_URL__';

    # ── Habilita Serviço e Tipo de ticket (#1E form-meta) ───────────
    #   Sem isto o Znuny não usa serviços/tipos e os dropdowns do portal
    #   do cliente ficam vazios (FormMeta.pm gatea em Ticket::Type e
    #   Service::CustomerUserServiceMemberList retorna vazio).
    $Self->{'Ticket::Service'} = 1;
    $Self->{'Ticket::Type'}    = 1;

    # ── data inserted by installer ──────────────────────────────────
    # $DIBI$

    return 1;
}

# ── needed system stuff (don't edit) ────────────────────────────────
use Kernel::Config::Defaults; # import Translatable()
use parent qw(Kernel::Config::Defaults);

1;
